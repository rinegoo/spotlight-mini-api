# Токен импорта каталога от encore-sync (тот же передаётся encore-sync -token).
# Сгенерировать: openssl rand -hex 32. Пусто — импорт выключен.
IMPORT_TOKEN=
# Ограничения контента: регион заведения (RU; none — выключить). Минимумы по закону:
# иноагенты — указание (можно ужесточить до hide), экстремистские материалы — скрыть.
RESTRICTIONS_REGION=RU
# RESTRICTIONS_POLICY_RU_INOAGENT=hide
# Размер указания относительно основного текста (по закону — 2).
RESTRICTIONS_LABEL_SCALE=2
# Папка данных на хосте: выгрузка каталога (.xls или base.db — запасной путь),
# импорт от encore-sync, ограничения (restrictions/manual.yaml, выгрузки реестров).
# Должна быть доступна на запись uid 10001: sudo chown -R 10001:10001 /opt/karaoke/data
DATA_DIR=/opt/karaoke/data
CATALOG_FILENAME=catalog.xls
# Как часто проверять файл на изменения.
CATALOG_WATCH_INTERVAL=30s
# Порт веб-интерфейса на хосте.
WEB_PORT=3000
# Теги образов (latest — последняя сборка main; можно закрепить версию, например 1.0.0).
API_TAG=latest
WEB_TAG=latest
